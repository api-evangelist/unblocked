  "item": [
    {
      "id": "6fe8c913-e590-4317-8f14-ef9b2952b0e3",
      "name": "Documents",
      "description": {
        "content": "A document contains content that Unblocked uses to answer questions. Each document is associated with a collection, so you must create a collection before adding documents. Documents used to provide answers will appear as references in the Unblocked interface.\n\nYou can create and delete documents as needed.\n",
        "type": "text/plain"
      },
